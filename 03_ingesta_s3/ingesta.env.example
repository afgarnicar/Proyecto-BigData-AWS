# Configuración de la ingesta (punto 3).
# En la EC2: copiar este archivo como ~/ingesta/.env y completar los valores.
# El .env real tiene la contraseña de RDS: nunca se sube al repositorio.

# Bucket del data lake
S3_BUCKET=proyecto2-siniestros
AWS_REGION=us-east-1

# RDS MariaDB (fuente de Antioquia)
RDS_HOST=proyecto2-mariadb.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
RDS_PORT=3306
RDS_DATABASE=siniestros_viales
RDS_USER=admin
RDS_PASSWORD=
RDS_SSL_CA=/home/ec2-user/carga/global-bundle.pem

# Archivo en la EC2 (fuente de Bogotá)
EC2_CSV_PATH=/home/ec2-user/fuentes/bogota/fuente_ec2_bogota.csv
